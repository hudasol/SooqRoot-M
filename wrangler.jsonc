{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // SooqRoot is a static single page app: no server code, no database.
  // This deploys the Vite build as a Workers static asset site on workers.dev.
  "name": "sooqroot",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    // The app uses hash routing, but this keeps deep links working if it
    // ever moves to history routing.
    "not_found_handling": "single-page-application"
  },

  "observability": { "enabled": true }
}
